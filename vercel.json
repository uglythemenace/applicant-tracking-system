{
  "rewrites": [
    {
      "source": "/",
      "destination": "/templates/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/templates/dashboard.html"
    },
    {
      "source": "/jobs",
      "destination": "/templates/jobs.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}