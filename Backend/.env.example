SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Comma-separated Supabase Auth user emails allowed to use the staff area.
ADMIN_EMAILS=staff@example.com
PUBLIC_CONTACT_EMAIL=careers@example.com
ADMIN_API_KEY=replace-with-a-long-random-secret
APPLICATION_COOLDOWN_SECRET=replace-with-another-long-random-secret
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Rolebeam Careers <careers@your-verified-domain.com>
# Use Resend with a verified domain, or Gmail SMTP with an app password.
EMAIL_PROVIDER=resend
SMTP_USERNAME=your.account@gmail.com
SMTP_APP_PASSWORD=generate-this-in-your-Google-account
SMTP_FROM_NAME=Rolebeam Careers
FRONTEND_URL=http://localhost:8000
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
